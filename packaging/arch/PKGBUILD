# bspwm-cyberquote — Cairo/Pango desktop quote ticker for bspwm.
# Build in-place: run `makepkg -si` from this repository root.
# Maintainer: MagnesiaReal <github@MagnesiaReal>

pkgname=bspwm-cyberquote
pkgver=0.1.0
pkgrel=1
pkgdesc="Cairo/Pango desktop quote ticker for bspwm — cyberpunk overlay, no WebView"
arch=('x86_64')
url="https://github.com/MagnesiaReal/bspwm-cyberquote"
license=('MIT')
depends=('gtk3' 'glib2' 'pango' 'cairo')
makedepends=('rust' 'pkgconf')
# In-tree PKGBUILD: source = this checkout, so there is nothing to fetch.
source=()
sha256sums=()

build() {
    cd "$startdir"
    cargo build --release --locked
}

check() {
    cd "$startdir"
    cargo test --release --locked
}

package() {
    # Binary.
    install -Dm755 "$startdir/target/release/bspwm-cyberquote" \
        "$pkgdir/usr/bin/bspwm-cyberquote"
    # System-wide default config (auto-copied to ~/.config on first run).
    install -Dm644 "$startdir/packaging/arch/config.toml" \
        "$pkgdir/etc/bspwm-cyberquote/config.toml"
    # Quote pool.
    install -Dm644 "$startdir/quotes.json" \
        "$pkgdir/usr/share/bspwm-cyberquote/quotes.json"
    # Docs + license.
    install -Dm644 "$startdir/README.md" \
        "$pkgdir/usr/share/doc/bspwm-cyberquote/README.md"
    install -Dm644 "$startdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}