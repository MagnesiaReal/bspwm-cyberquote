# bspwm-cyberquote — Cairo/Pango desktop quote ticker for bspwm.
# Build in-place: run `makepkg -si` from this repository root or from packaging/arch.
# Maintainer: MagnesiaReal <github@MagnesiaReal>

pkgname=bspwm-cyberquote
pkgver=0.1.0
pkgrel=1
pkgdesc="Cairo/Pango desktop quote ticker for bspwm — cyberpunk overlay, no WebView"
arch=('x86_64')
url="https://github.com/MagnesiaReal/bspwm-cyberquote"
license=('MIT')
depends=('gtk3' 'glib2' 'pango' 'cairo')
makedepends=('rust' 'pkgconf')
# In-tree PKGBUILD: source = this checkout, so there is nothing to fetch.
source=()
sha256sums=()

# Locate the repository root (works whether makepkg is run from the repo root
# or from packaging/arch/). $startdir is the directory makepkg was invoked in;
# cargo itself walks up from there, so we do the same.
_repodir() {
    local d="$startdir"
    while :; do
        if [[ -f "$d/Cargo.toml" && -d "$d/src" ]]; then
            printf '%s\n' "$d"
            return 0
        fi
        d="$(dirname "$d")"
        [[ "$d" == "/" ]] && break
    done
    return 1
}

build() {
    local repo
    repo="$(_repodir)" || { printf 'error: could not locate repository root from %s\n' "$startdir" >&2; return 1; }
    cd "$repo"
    cargo build --release --locked
}

check() {
    local repo
    repo="$(_repodir)" || { printf 'error: could not locate repository root from %s\n' "$startdir" >&2; return 1; }
    cd "$repo"
    cargo test --release --locked
}

package() {
    local repo
    repo="$(_repodir)" || { printf 'error: could not locate repository root from %s\n' "$startdir" >&2; return 1; }
    # Binary.
    install -Dm755 "$repo/target/release/bspwm-cyberquote" \
        "$pkgdir/usr/bin/bspwm-cyberquote"
    # System-wide default config (auto-copied to ~/.config on first run).
    install -Dm644 "$repo/packaging/arch/config.toml" \
        "$pkgdir/etc/bspwm-cyberquote/config.toml"
    # Quote pool.
    install -Dm644 "$repo/quotes.json" \
        "$pkgdir/usr/share/bspwm-cyberquote/quotes.json"
    # Docs + license.
    install -Dm644 "$repo/README.md" \
        "$pkgdir/usr/share/doc/bspwm-cyberquote/README.md"
    install -Dm644 "$repo/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}